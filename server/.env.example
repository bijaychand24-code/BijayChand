# Server Configuration
NODE_ENV=production
PORT=5000

# Comma-free origin allowed by CORS (not needed when served through the bundled
# nginx proxy, but useful if you call the API directly).
CORS_ORIGIN=https://bijaychand.me

# MongoDB (optional). If omitted the API runs without persistence.
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Email Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=your-email@gmail.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
