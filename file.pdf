<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <script type="module">import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;</script>

    <script type="module" src="/@vite/client"></script>

    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050816" />
    
    <!-- Primary SEO Meta Tags -->
    <title>Bijay Chand | Cloud & DevOps Enthusiast | Cyber Security Student</title>
    <meta name="title" content="Bijay Chand | Cloud & DevOps Enthusiast | Cyber Security Student" />
    <meta name="description" content="Portfolio of Bijay Chand — BCA Cyber Security student focused on Cloud Computing, DevOps, Web Development, Cyber Security and SEO." />
    <meta name="keywords" content="Bijay Chand, Cloud Computing, DevOps, Cyber Security, Web Development, SEO, AWS, Docker, Kubernetes, React, Node.js, Portfolio" />
    <meta name="author" content="Bijay Chand" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bijaychand.dev/" />
    <meta property="og:title" content="Bijay Chand | Cloud & DevOps Enthusiast | Cyber Security Student" />
    <meta property="og:description" content="Portfolio of Bijay Chand — BCA Cyber Security student focused on Cloud Computing, DevOps, Web Development, Cyber Security and SEO." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:site_name" content="Bijay Chand Portfolio" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://bijaychand.dev/" />
    <meta property="twitter:title" content="Bijay Chand | Cloud & DevOps Enthusiast | Cyber Security Student" />
    <meta property="twitter:description" content="Portfolio of Bijay Chand — BCA Cyber Security student focused on Cloud Computing, DevOps, Web Development, Cyber Security and SEO." />
    <meta property="twitter:image" content="/og-image.jpg" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://bijaychand.dev/" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    
    <!-- Sitemap & Robots -->
    <link rel="sitemap" href="/sitemap.xml" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Bijay Chand",
      "url": "https://bijaychand.dev/",
      "sameAs": [
        "https://github.com/bijaychand24-code",
        "https://www.linkedin.com/in/bijay-chand"
      ],
      "jobTitle": "BCA Cyber Security Student | Cloud & DevOps Enthusiast",
      "worksFor": {
        "@type": "Organization",
        "name": "Maya Devi University"
      },
      "knowsAbout": ["Cloud Computing", "DevOps", "Cyber Security", "Web Development", "SEO", "AWS", "Docker", "Kubernetes", "React", "Node.js"],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Maya Devi University",
        "location": "Dehradun, Uttarakhand, India"
      }
    }
    </script>
  </head>
  <body class="h-full bg-primary text-text-light antialiased" style="font-family: 'Inter', system-ui, sans-serif;">
    <div id="root" class="h-full"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>